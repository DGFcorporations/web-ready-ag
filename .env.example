# ── Backend ─────────────────────────────────────────────────────
# Used for JWT signing. Generate with: openssl rand -hex 32
APP_ID=
APP_SECRET=

# ── Database ───────────────────────────────────────────────────
# MySQL connection string. For local dev, use a local MySQL instance.
# For production (Cloudflare Pages), set this in the Cloudflare Pages dashboard
# under Settings > Environment Variables. NEVER commit the real value.
# Real values live in C:\Dev\.env (per the FILE-LAW).
DATABASE_URL=

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=
VITE_APP_ID=

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=
KIMI_OPEN_URL=

# ── Admin Role ──────────────────────────────────────────────────
# Union ID of the app creator; this user gets role "admin" on first login
OWNER_UNION_ID=

# ── Cloudflare Pages ────────────────────────────────────────────
# Set automatically by Cloudflare Pages. Used to switch between server and function mode.
# CF_PAGES=true
